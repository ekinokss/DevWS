<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DevWS-Setup</AssemblyName>
    <AssemblyTitle>DevWS setup</AssemblyTitle>
    <Product>DevWS</Product>
    <Company>ekinokss</Company>
    <RootNamespace>DevWS.Setup</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>
    <Version Condition="'$(DevWSProductVersion)' != ''">$(DevWSProductVersion)</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(DevWSPayloadZip)' != ''">
    <EmbeddedResource Include="$(DevWSPayloadZip)" LogicalName="DevWS.Setup.Payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PackageCleanup.ps1" LogicalName="DevWS.Setup.Cleanup.ps1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DevWSSourceSha" Value="$(DevWSSourceSha)" Condition="'$(DevWSSourceSha)' != ''" />
    <AssemblyMetadata Include="DevWSProductId" Value="$(DevWSProductId)" Condition="'$(DevWSProductId)' != ''" />
    <AssemblyMetadata Include="DevWSDisplayName" Value="$(DevWSDisplayName)" Condition="'$(DevWSDisplayName)' != ''" />
    <AssemblyMetadata Include="DevWSPublisher" Value="$(DevWSPublisher)" Condition="'$(DevWSPublisher)' != ''" />
    <AssemblyMetadata Include="DevWSProductVersion" Value="$(DevWSProductVersion)" Condition="'$(DevWSProductVersion)' != ''" />
    <AssemblyMetadata Include="DevWSProgramFilesRootLeaf" Value="$(DevWSProgramFilesRootLeaf)" Condition="'$(DevWSProgramFilesRootLeaf)' != ''" />
    <AssemblyMetadata Include="DevWSInstallRootLeaf" Value="$(DevWSInstallRootLeaf)" Condition="'$(DevWSInstallRootLeaf)' != ''" />
    <AssemblyMetadata Include="DevWSURLInfoAbout" Value="$(DevWSURLInfoAbout)" Condition="'$(DevWSURLInfoAbout)' != ''" />
  </ItemGroup>
</Project>
